{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/content/**",
              "components/forms/**",
              "components/navigation/**",
              "components/type/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pacaembu|IM Fell English))/i]",
        "message": "Font not provided by the design system. Available: Pacaembu, IM Fell English."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:boucle-dor|haricot|violet|violet-2|blanc)$/]",
        "message": "<Badge> tone must be one of 'boucle-dor' | 'haricot' | 'violet' | 'violet-2' | 'blanc'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|arrow|plis|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, arrow, plis, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:boucle-dor|haricot|violet|encre|lait|ghost)$/]",
        "message": "<Button> variant must be one of 'boucle-dor' | 'haricot' | 'violet' | 'encre' | 'lait' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|surface|padding|plis|as|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, surface, padding, plis, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:blanc|lait)$/]",
        "message": "<Card> surface must be one of 'blanc' | 'lait'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:div|article|section|form)$/]",
        "message": "<Card> as must be one of 'div' | 'article' | 'section' | 'form'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Facts'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Facts> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|hint|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, children, hint, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|count|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: children, active, count, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|pli|as|tone|style|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: children, pli, as, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute[name.name='pli'] > Literal[value!=/^(?:haricot|boucle-dor|violet)$/]",
        "message": "<Kicker> pli must be one of 'haricot' | 'boucle-dor' | 'violet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:p|span|div)$/]",
        "message": "<Kicker> as must be one of 'p' | 'span' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:encre|lait)$/]",
        "message": "<Kicker> tone must be one of 'encre' | 'lait'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|width|base|protect|alt|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, tone, width, base, protect, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:horizontal|carre|rond)$/]",
        "message": "<Logo> variant must be one of 'horizontal' | 'carre' | 'rond'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:couleur|encre|lait)$/]",
        "message": "<Logo> tone must be one of 'couleur' | 'encre' | 'lait'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pager'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|pages|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Pager> doesn't accept that prop. Declared props: page, pages, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|bleed|padding|as|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children, tone, bleed, padding, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:encre|haricot|boucle-dor|violet|violet-2)$/]",
        "message": "<Panel> tone must be one of 'encre' | 'haricot' | 'boucle-dor' | 'violet' | 'violet-2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:section|div|aside)$/]",
        "message": "<Panel> as must be one of 'section' | 'div' | 'aside'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Plis'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|tone|pair|single|animate|hidden|play|title|style|key|ref|className|style|children)$/]",
        "message": "<Plis> doesn't accept that prop. Declared props: height, tone, pair, single, animate, hidden, play, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Plis'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:couleur|encre|lait)$/]",
        "message": "<Plis> tone must be one of 'couleur' | 'encre' | 'lait'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RomanNumeral'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<RomanNumeral> doesn't accept that prop. Declared props: n, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RomanNumeral'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:encre|lait)$/]",
        "message": "<RomanNumeral> tone must be one of 'encre' | 'lait'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|plis|align|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: children, as, plis, align, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3)$/]",
        "message": "<SectionTitle> as must be one of 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionTitle> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:encre|lait)$/]",
        "message": "<SectionTitle> tone must be one of 'encre' | 'lait'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Step'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Step> doesn't accept that prop. Declared props: n, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|variant|active|tone|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, variant, active, tone, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:inline|nav|more)$/]",
        "message": "<TextLink> variant must be one of 'inline' | 'nav' | 'more'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:encre|lait)$/]",
        "message": "<TextLink> tone must be one of 'encre' | 'lait'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
